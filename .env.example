# ================================================================
# OmniContext Configuration Template
# Copy this file to .env and customize for your machine
# ================================================================

# Environment Mode:
# 'local' = Standalone local mode (SQLite FTS5 + local embeddings, zero credentials needed)
# 'aws'   = Production mode (Amazon Bedrock + Amazon OpenSearch Serverless)
ENV=local

# ----------------------------------------------------------------
# AWS Configuration (Used when ENV=aws)
# ----------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock Foundation Models
# Claude 3.5 Sonnet / Claude 3.7 Sonnet for agent reasoning loop
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Amazon Titan Text Embeddings v2 for vector representations
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Amazon OpenSearch Serverless (AOSS) Collection Endpoint
# Format: https://<collection-id>.<region>.aoss.amazonaws.com
AOSS_ENDPOINT=
AOSS_INDEX_NAME=omnicontext-code-index

# ----------------------------------------------------------------
# Local Storage Paths (Used when ENV=local)
# ----------------------------------------------------------------
SQLITE_DB_PATH=data/omnicontext_graph.db

# ----------------------------------------------------------------
# MCP Server Configuration
# ----------------------------------------------------------------
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_TRANSPORT=stdio

# ----------------------------------------------------------------
# Agent Guardrails & Safety Limits
# ----------------------------------------------------------------
MAX_GRAPH_TRAVERSAL_DEPTH=4
MAX_TOOL_CALLS_PER_TURN=10
MAX_CONTEXT_TOKEN_BUDGET=12000
